{
  "name": "@cmdless/ensure-electron",
  "version": "0.0.2",
  "license": "MIT",
  "type": "module",
  "description": "Facilitates installing a centralized Electron binary and building native app dependencies all at runtime, allowing for Electron apps to be run over CLI.",
  "author": {
    "name": "Fluttershy",
    "url": "https://github.com/Fluttershy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdless/ensure-electron.git"
  },
  "files": [
