    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@electron/get": "5.1.0",
    "@electron/rebuild": "4.2.0",
    "extract-zip": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "typescript": "^5.8.0"
